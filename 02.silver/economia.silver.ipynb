{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 02 · SILVER — Limpeza, Normalização & Join\n",
    "\n",
    "**Entradas:**  \n",
    "- `etl_pos__bronze.ipca` — IPCA mensal (BCB · formato `dd/MM/yyyy`)  \n",
    "- `etl_pos__bronze.boi_gordo` — Preço arroba boi gordo (CEPEA · formato `MM/yyyy`)  \n",
    "\n",
    "**Saída:** `etl_pos__silver.economia`\n",
    "\n",
    "**Schema final:**  \n",
    "```\n",
    "data             DateType   yyyy-MM-dd (dia fixo = 01)\n",
    "ipca             Double     variacao percentual mensal BCB\n",
    "boi_gordo        Double     preco R$/arroba CEPEA\n",
    "data_coleta_ipca Timestamp  herança bronze\n",
    "data_coleta_boi  Timestamp  herança bronze\n",
    "```\n",
    "\n",
    "**ADR-002:** Normalização obrigatória via string intermediária `yyyy-MM` antes do join.\n",
    "\n",
    "> **PRÉ-REQUISITO:** Ambos os notebooks Bronze executados com sucesso."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 1 — Imports\n",
    "# ============================================================\n",
    "from pyspark.sql import SparkSession\n",
    "from pyspark.sql import functions as F\n",
    "from pyspark.sql.types import DoubleType\n",
    "\n",
    "spark = SparkSession.builder.getOrCreate()\n",
    "\n",
    "SRC_IPCA    = \"etl_pos__bronze.ipca\"\n",
    "SRC_BOI     = \"etl_pos__bronze.boi_gordo\"\n",
    "TARGET      = \"etl_pos__silver.economia\"\n",
    "\n",
    "print(f\"Fontes  : {SRC_IPCA}, {SRC_BOI}\")\n",
    "print(f\"Destino : {TARGET}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 2 — Leitura das tabelas Bronze\n",
    "# ============================================================\n",
    "ipca = spark.table(SRC_IPCA)\n",
    "boi  = spark.table(SRC_BOI)\n",
    "\n",
    "print(\"=== IPCA (Bronze) ===\")\n",
    "ipca.printSchema()\n",
    "\n",
    "print(\"\\n=== BOI GORDO (Bronze) ===\")\n",
    "boi.printSchema()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 3 — Normalização IPCA\n",
    "# BCB envia: \"dd/MM/yyyy\" (ex: \"01/01/2024\")\n",
    "# ADR-002: converter para string \"yyyy-MM\" como chave de join\n",
    "# ============================================================\n",
    "\n",
    "ipca_norm = (\n",
    "    ipca\n",
    "    # Passo 1: string \"dd/MM/yyyy\" → DateType real\n",
    "    .withColumn(\"data_dt\", F.to_date(F.col(\"data\"), \"dd/MM/yyyy\"))\n",
    "    # Passo 2: DateType → string \"yyyy-MM\" (chave de join)\n",
    "    .withColumn(\"join_key\", F.date_format(F.col(\"data_dt\"), \"yyyy-MM\"))\n",
    "    # Remover coluna intermediária\n",
    "    .drop(\"data\")\n",
    "    # Garantir tipo Double para ipca\n",
    "    .withColumn(\"ipca\", F.col(\"ipca\").cast(DoubleType()))\n",
    "    # Renomear data_coleta\n",
    "    .withColumnRenamed(\"data_coleta\", \"data_coleta_ipca\")\n",
    ")\n",
    "\n",
    "print(\"IPCA normalizado:\")\n",
    "ipca_norm.printSchema()\n",
    "ipca_norm.orderBy(\"join_key\").show(5, truncate=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 4 — Normalização Boi Gordo\n",
    "# CEPEA envia: \"MM/yyyy\" (ex: \"01/2024\")\n",
    "# ADR-002: converter para string \"yyyy-MM\" como chave de join\n",
    "# ============================================================\n",
    "\n",
    "# Renomear para nomes canônicos (ajuste se CSV CEPEA for diferente)\n",
    "boi_norm = boi.withColumnRenamed(\"data_cepea\", \"data_raw\") \\\n",
    "               .withColumnRenamed(\"valor_cepea\", \"boi_gordo_raw\")\n",
    "\n",
    "boi_norm = (\n",
    "    boi_norm\n",
    "    # Passo 1: string \"MM/yyyy\" → DateType (dia = 01 implícito)\n",
    "    .withColumn(\"data_dt\", F.to_date(F.col(\"data_raw\"), \"MM/yyyy\"))\n",
    "    # Passo 2: DateType → string \"yyyy-MM\" (chave de join)\n",
    "    .withColumn(\"join_key\", F.date_format(F.col(\"data_dt\"), \"yyyy-MM\"))\n",
    "    # Normalizar valor: substituir vírgula por ponto e converter para Double\n",
    "    .withColumn(\n",
    "        \"boi_gordo\",\n",
    "        F.regexp_replace(F.col(\"boi_gordo_raw\").cast(\"string\"), \",\", \".\").cast(DoubleType())\n",
    "    )\n",
    "    # Remover colunas brutas\n",
    "    .drop(\"data_raw\", \"boi_gordo_raw\", \"data_dt\")\n",
    "    # Renomear data_coleta\n",
    "    .withColumnRenamed(\"data_coleta\", \"data_coleta_boi\")\n",
    ")\n",
    "\n",
    "print(\"Boi Gordo normalizado:\")\n",
    "boi_norm.printSchema()\n",
    "boi_norm.orderBy(\"join_key\").show(5, truncate=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 5 — Verificação de overlap antes do join\n",
    "# ============================================================\n",
    "ipca_keys = set(r[\"join_key\"] for r in ipca_norm.select(\"join_key\").collect())\n",
    "boi_keys  = set(r[\"join_key\"] for r in boi_norm.select(\"join_key\").collect())\n",
    "overlap   = ipca_keys & boi_keys\n",
    "\n",
    "print(f\"Periodos IPCA   : {len(ipca_keys)} meses\")\n",
    "print(f\"Periodos Boi    : {len(boi_keys)} meses\")\n",
    "print(f\"Overlap (inner) : {len(overlap)} meses — {sorted(overlap)[:5]}...\")\n",
    "\n",
    "if len(overlap) < 12:\n",
    "    print(\"AVISO: Menos de 12 meses em comum. Verificar uploads.\")\n",
    "else:\n",
    "    print(\"Overlap >= 12 meses — OK para join\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 6 — Join por join_key (string \"yyyy-MM\")\n",
    "# ADR-002: join via string intermediária garante estabilidade.\n",
    "#          Nunca fazer join diretamente por DateType ou\n",
    "#          por strings de formatos diferentes.\n",
    "# ============================================================\n",
    "ip = ipca_norm.alias(\"ip\")\n",
    "bo = boi_norm.alias(\"bo\")\n",
    "\n",
    "df_join = (\n",
    "    ip.join(bo, F.col(\"ip.join_key\") == F.col(\"bo.join_key\"), \"inner\")\n",
    "    .select(\n",
    "        F.col(\"ip.join_key\").alias(\"periodo\"),     # string \"yyyy-MM\" temporária\n",
    "        F.col(\"ip.ipca\"),\n",
    "        F.col(\"bo.boi_gordo\"),\n",
    "        F.col(\"ip.data_coleta_ipca\"),\n",
    "        F.col(\"bo.data_coleta_boi\"),\n",
    "    )\n",
    ")\n",
    "\n",
    "# Pós-join: converter join_key para DateType real (dia 01)\n",
    "df_join = df_join.withColumn(\n",
    "    \"data\",\n",
    "    F.to_date(F.col(\"periodo\"), \"yyyy-MM\")\n",
    ").drop(\"periodo\")\n",
    "\n",
    "# Reorganizar colunas\n",
    "df_silver = df_join.select(\n",
    "    \"data\",\n",
    "    \"ipca\",\n",
    "    \"boi_gordo\",\n",
    "    \"data_coleta_ipca\",\n",
    "    \"data_coleta_boi\",\n",
    ").orderBy(\"data\")\n",
    "\n",
    "print(f\"Registros após join: {df_silver.count()}\")\n",
    "df_silver.printSchema()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 7 — Data Quality checks\n",
    "# ============================================================\n",
    "null_ipca = df_silver.filter(F.col(\"ipca\").isNull()).count()\n",
    "null_boi  = df_silver.filter(F.col(\"boi_gordo\").isNull()).count()\n",
    "total     = df_silver.count()\n",
    "\n",
    "print(\"=\" * 50)\n",
    "print(\"DATA QUALITY — Pre-gravação Silver\")\n",
    "print(\"=\" * 50)\n",
    "print(f\"  Total registros    : {total}\")\n",
    "print(f\"  Nulls em ipca      : {null_ipca}\")\n",
    "print(f\"  Nulls em boi_gordo : {null_boi}\")\n",
    "print(f\"  DQ ipca OK         : {'SIM' if null_ipca == 0 else 'NAO — investigar'}\")\n",
    "print(f\"  DQ boi_gordo OK    : {'SIM' if null_boi == 0 else 'NAO — investigar'}\")\n",
    "\n",
    "print(\"\\nEstatísticas descritivas:\")\n",
    "df_silver.select(\"ipca\", \"boi_gordo\").describe().show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 8 — Preview final\n",
    "# ============================================================\n",
    "display(df_silver)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 9 — Gravar Silver (Delta · append + overwriteSchema)\n",
    "# ============================================================\n",
    "(\n",
    "    df_silver\n",
    "    .write\n",
    "    .format(\"delta\")\n",
    "    .mode(\"append\")\n",
    "    .option(\"overwriteSchema\", \"true\")\n",
    "    .saveAsTable(TARGET)\n",
    ")\n",
    "\n",
    "print(f\"Tabela '{TARGET}' gravada com sucesso!\")\n",
    "print(f\"Total de registros na Silver: {spark.table(TARGET).count()}\")"
   ]
  }
 ],
